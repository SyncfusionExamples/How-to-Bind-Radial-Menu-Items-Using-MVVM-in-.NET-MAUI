<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindRadialItems.MainPage"
             xmlns:viewModel="clr-namespace:BindRadialItems"
             xmlns:radialMenu="clr-namespace:Syncfusion.Maui.RadialMenu;assembly=Syncfusion.Maui.RadialMenu">

    <ContentPage.BindingContext>
        <viewModel:RadialMenuViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <radialMenu:SfRadialMenu
                    CenterButtonRadius="35"
                    CenterButtonSize="70"
                    CenterButtonFontFamily="MauiMaterialAssets"
                    CenterButtonFontSize="24"
                    CenterButtonText="&#xe710;"
                    ItemsSource="{Binding MenuItems}">
            <radialMenu:SfRadialMenu.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Label Text="{Binding Icon}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontFamily="MauiMaterialAssets"
                               FontSize="20" />
                    </Grid>
                </DataTemplate>
            </radialMenu:SfRadialMenu.ItemTemplate>
        </radialMenu:SfRadialMenu>
    </Grid>

</ContentPage>
